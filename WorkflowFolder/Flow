        "display": "Example Medication"
      }
    ],
    "text": "Example Medication"
  },

  "subject": {
    "reference": "Patient/P1001"
  },

  "encounter": {
    "reference": "Encounter/E1001"
  },

  "authoredOn": "2026-09-30",

  "requester": {
    "reference": "Practitioner/PR1001"
  },

  "reasonReference": [
    {
      "reference": "Condition/C1001"
    }
  ],

  "dosageInstruction": [
    {
      "text": "Take 1 tablet by mouth twice daily for 30 days",
      "timing": {
